# ===== Site =====
# 博客部署在子域名时使用 https://blog.chasey.top
NEXT_PUBLIC_SITE_URL=https://blog.chasey.top
NEXT_PUBLIC_SITE_NAME=Chasey
NEXT_PUBLIC_SITE_DESCRIPTION=河海大学大二学生，兼职宇宙超人。记录代码、阅读与在太阳系里的日常。

# ===== 备案信息（中国大陆 ICP 备案后填写） =====
# 注意：Vercel 不是中国大陆 ICP 备案接入服务商。真实备案号请使用境内节点服务商
#（腾讯云 / 阿里云等）完成备案后在 Vercel 前端仅作展示；不要填写虚假备案号。
NEXT_PUBLIC_ICP_NUMBER=
NEXT_PUBLIC_PUBLIC_SECURITY_NUMBER=
NEXT_PUBLIC_PUBLIC_SECURITY_URL=

# ===== 评论：Giscus（GitHub Discussions） =====
NEXT_PUBLIC_GISCUS_REPO=your-name/chasey-blog
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# ===== 点赞 / 阅读统计 =====
# 阿里云：填写 Redis 连接串（本地 compose 用 redis://redis:6379，云数据库用专有网络地址）
REDIS_URL=
# Vercel（可选）：在 Storage 中创建 KV 后自动注入
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ===== 构建时数据（可选） =====
GITHUB_REPO=your-name/chasey-blog
GITHUB_TOKEN=
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-name

# ===== Cron =====
CRON_SECRET=replace-with-a-long-random-string
