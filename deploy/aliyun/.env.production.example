# ===== 公共构建期变量（Docker build args）=====
NEXT_PUBLIC_SITE_URL=https://chasey.top
NEXT_PUBLIC_SITE_NAME=Chasey
NEXT_PUBLIC_SITE_DESCRIPTION=河海大学大二学生，兼职宇宙超人。记录代码、阅读与在太阳系里的日常。
NEXT_PUBLIC_GISCUS_REPO=your-name/chasey-blog
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-name

# ===== 运行时变量 =====
# 本地 docker compose 的 Redis 地址；使用阿里云 Redis 时改成专有网络地址
REDIS_URL=redis://redis:6379
# 如果没有 Redis，也可以继续使用 Vercel KV 的 REST 变量（可选）
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

CRON_SECRET=请替换为至少32位随机字符串
GITHUB_REPO=your-name/chasey-blog
GITHUB_TOKEN=

# ===== 备案信息 =====
# 只有阿里云 ECS 完成 ICP 备案后才填写真实备案号
NEXT_PUBLIC_ICP_NUMBER=
NEXT_PUBLIC_PUBLIC_SECURITY_NUMBER=
NEXT_PUBLIC_PUBLIC_SECURITY_URL=
